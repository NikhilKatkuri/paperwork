# Web app deployment configuration (Next.js)
# Absolute origin of the API server. Used by next.config.ts to rewrite
# /api/v1/* to the backend. Leave unset only when the API is same-origin.
API_PROXY_ORIGIN=<string>

# Cloudinary cloud name. Restricts the Next image optimizer to this account;
# if unset, no remote Cloudinary patterns are allowed.
CLOUDINARY_CLOUD_NAME=<string>

# Must be the SAME value as the server's JWT_REFRESH_SECRET. The Next.js
# middleware verifies the refresh-token cookie with it for page gating.
JWT_REFRESH_SECRET=<string>

# Public canonical site URL, used for metadata/sitemap.
NEXT_PUBLIC_SITE_URL=<string>
