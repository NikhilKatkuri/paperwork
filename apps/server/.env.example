NODE_ENV=<string>
PORT=<number>
HOST=<string>
WEB_URL=<string>
DEBUG=<boolean>

MONGO_URI=<string>
REDIS_URL=<string>

DEV_ORIGINS=<array:string>
PROD_ORIGINS=<array:string>

# --- Logging & security audit -------------------------------------------
# Minimum winston level: error|warn|info|http|verbose|debug|silly
# Defaults to info, or debug in development when DEBUG=true.
LOG_LEVEL=<string>
# Log redacted request bodies. Defaults to true in development and false in
# production: bodies carry passwords, OTPs, reset tokens and form answers.
LOG_REQUEST_BODY=<boolean>
# Log CORS preflight (OPTIONS) requests. Defaults to false.
LOG_PREFLIGHT=<boolean>
# A client exceeding this many 4xx responses inside the window is logged as
# SECURITY_SUSPICIOUS_PAYLOAD. 401/403 are excluded because they are already
# logged at the source with their real reason.
LOG_SUSPICIOUS_PAYLOAD_THRESHOLD=<number>
LOG_SUSPICIOUS_PAYLOAD_WINDOW_MS=<number>

SALT_ROUNDS=<number>

JWT_SECRET=<string>
JWT_TEMP_SECRET=<string>
JWT_REFRESH_SECRET=<string>
JWT_RESET_PASSWORD_SECRET=<string>

JWT_EXPIRES_IN=<number>
JWT_TEMP_EXPIRES_IN=<number>
JWT_REFRESH_EXPIRES_IN=<number>
JWT_RESET_PASSWORD_EXPIRES_IN=<number>

OTP_SECRET=<string>
OTP_EXPIRATION=<number>

MAIL_HOST=<string>
MAIL_PORT=<number>
MAIL_SECURE=<boolean>
MAIL_HOST_USER=<string>
MAIL_HOST_PASS=<string>

CLOUDINARY_CLOUD_NAME=<string>
CLOUDINARY_API_KEY=<string>
CLOUDINARY_API_SECRET=<string>
CLOUDINARY_SIGNED_URL_EXPIRATION=<number>
CLOUDINARY_FOLDER=<string>
CLOUDINARY_BUCKET_WINDOW_EXPIRATION=<number>
CLOUDINARY_BUCKET_WINDOW_BUFFER=<number>

ARGON_TYPE=<string>
ARGON_MEMORY_COST=<number>
ARGON_TIME_COST=<number>
ARGON_PARALLELISM=<number>
ARGON_HASH_LENGTH=<number>
ARGON_SECRET=<string>